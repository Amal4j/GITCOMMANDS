git config --global --list


git add filename or git add . ( make file ready for stage)
git commit -m "type message" ( file ko repo mein lejayega) 

.gitignore ( is file mein woh files ka nam likho jisko tracking nahi karn ho)

git remote add origin   ( remote reop ka address do )
git remote remove origin  ( vscode se repo ka connectivity band kar dega ) 
git remote -v ( repo detail show karega )  

git rm -r --cached .terraform  ( agar ye file track ho rahi hogi to iski tracking remove karega)

git push -u origin test  ( test branch ka naam hai )
git log --oneline  ( log dekhne ko )

